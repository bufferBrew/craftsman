#!/usr/bin/env bash
# PreToolUse hook (Bash matcher) — when a git commit/push/tag or a gh PR command
# is about to run, surface the craftsman:commit-craft conventions. Self-contained:
# references only craftsman's own skill, never the superpowers plugin.

set -uo pipefail

input="$(cat)"

extract_command() {
  for pybin in python3 python; do
    if command -v "$pybin" >/dev/null 2>&1; then
      out=$(printf '%s' "$input" | "$pybin" -c "import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))" 2>/dev/null) && [ -n "$out" ] && { printf '%s' "$out"; return; }
    fi
  done
  printf '%s' "$input" | grep -o '"command"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/^"command"[[:space:]]*:[[:space:]]*"//; s/"$//'
}

cmd="$(extract_command || true)"

case "$cmd" in
  *"git commit"*|*"git push"*|*"git tag"*|*"gh pr create"*|*"gh pr merge"*)
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"About to run git/PR plumbing — apply craftsman:commit-craft: atomic scope, imperative subject under ~50 chars, the plugin Co-Authored-By trailer, and commit/push/PR only when the user asked. Do not use --no-verify or bypass signing unless explicitly requested."}}\n' ;;
esac

exit 0
